# ===== VARIABLES D'ENVIRONNEMENT =====
# Copiez ce fichier en .env et ajustez les valeurs selon vos besoins

# URL du modèle GLTF (si hébergé en externe)
# VITE_CHARACTER_MODEL_URL=https://mon-cdn.com/models/character.glb

# Configuration de la scène
# VITE_ENABLE_ORBIT_CONTROLS=false
# VITE_BACKGROUND_COLOR=#0f0f1e

# Performance
# VITE_SHADOW_MAP_SIZE=2048
# VITE_MAX_DPR=2

# Analytics (optionnel)
# VITE_GA_ID=G-XXXXXXXXXX
